{
  "name": "@readium/navigator",
  "version": "2.8.2",
  "type": "module",
  "description": "Next generation SDK for publications in Web Apps",
  "author": "readium",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/readium/ts-toolkit.git",
    "directory": "navigator"
  },
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/readium/ts-toolkit/issues"
  },
  "homepage": "https://github.com/readium/ts-toolkit",
  "keywords": [
    "readium",
    "epub",
    "webpub",
    "divina",
    "reflowable",
    "fixed-layout",
    "publication",
    "ebook",
    "reader",
    "viewer"
  ],
  "types": "./types/src/index.d.ts",
  "exports": {
    ".": {
      "ts-toolkit-source": "./src/index.ts",
      "types": "./types/src/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "types"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rimraf types dist",
    "build": "pnpm clean && node scripts/generate-css-selector.js && tsc && vite build",
    "generate:css-selector": "node scripts/generate-css-selector.js"
  },
  "dependencies": {
    "@readium/decorator": "workspace:*",
    "@readium/helpers": "workspace:*",
    "@readium/navigator-html-injectables": "workspace:*",
    "@readium/shared": "workspace:*"
  },
  "devDependencies": {
    "@readium/css": "^2.0.5",
    "@types/path-browserify": "^1.0.3",
    "css-selector-generator": "^3.8.0",
    "path-browserify": "^1.0.1",
    "rimraf": "^6.1.3",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
