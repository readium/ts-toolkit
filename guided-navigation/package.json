{
  "name": "@readium/guided-navigation",
  "version": "1.1.1",
  "type": "module",
  "description": "Guided Navigation document generation from HTML and XHTML content",
  "author": "readium",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/readium/ts-toolkit.git",
    "directory": "guided-navigation"
  },
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/readium/ts-toolkit/issues"
  },
  "homepage": "https://github.com/readium/ts-toolkit",
  "keywords": [
    "readium",
    "guided-navigation",
    "accessibility",
    "read-aloud",
    "tts"
  ],
  "types": "./types/src/index.d.ts",
  "exports": {
    ".": {
      "ts-toolkit-source": "./src/index.ts",
      "types": "./types/src/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "types",
    "fixtures"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "rimraf types dist",
    "build": "pnpm clean && tsc && vite build",
    "test": "jest",
    "generate-fixtures-manifest": "node scripts/build-fixtures-manifest.js"
  },
  "dependencies": {
    "@readium/helpers": "workspace:*",
    "@readium/shared": "workspace:*",
    "css-selector-generator": "^3.9.4"
  },
  "devDependencies": {
    "@jest/environment-jsdom-abstract": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "jest": "^30.2.0",
    "jsdom": "^30.1.1",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.6",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
